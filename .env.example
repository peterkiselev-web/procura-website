# Copy to .env and fill in. Never commit .env.
PORT=3000
HOST=127.0.0.1

# Optional: email each enquiry (requires `npm install nodemailer`)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ENQUIRY_TO=
ENQUIRY_FROM=

# Venue waitlist (also set these under Netlify > Site configuration > Environment variables).
# The token lets the site write into ClickUp. Never commit it.
CLICKUP_TOKEN=
CLICKUP_LIST_ID=
# Optional. Comma separated ClickUp user ids to assign each waitlisted venue to.
CLICKUP_ASSIGNEE_IDS=
# Optional. Days until the first update reminder. Default 14.
UPDATE_CADENCE_DAYS=14
# Optional. Name of the status a venue moves to once it submits. Default Waitlisted.
WAITLIST_STATUS=Waitlisted

# ---------------------------------------------------------------------------------------------------------------
# QR rental (the /rent page). On Netlify, set these under Site configuration > Environment variables, scope
# "Functions" (and "Builds" for the RENTAL_* pricing values, which the terms page is built from).
# See README.md, "QR rental setup". Never commit real values.
# ---------------------------------------------------------------------------------------------------------------

# The live address of the site. Used in the supplier callback address and the return address after payment.
SITE_URL=https://procuracharge.com

# Stripe. Use a NEW restricted key for this site, not the supplier's key. Write access to: PaymentIntents,
# SetupIntents, Customers, PaymentMethods, Refunds. Start with test keys (rk_test_ / pk_test_).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint you create in Stripe for https://procuracharge.com/api/stripe/webhook
# (events: payment_intent.succeeded, charge.dispute.created).
STRIPE_WEBHOOK_SECRET=
# A live key is refused unless this is "yes". Leave unset until the full flow has passed on the real machine.
ALLOW_LIVE_PAYMENTS=
# Optional: JSON handed to the Payment Element's applePay option, for Apple's deferred or recurring payment sheet.
# Leave empty until you have confirmed the exact shape against the current Stripe docs.
STRIPE_APPLE_PAY_OPTIONS_JSON=

# Bajie Charging open API.
BAJIE_BASE_URL=https://developer.chargenow.top/cdb-open-api/v1
BAJIE_USERNAME=
BAJIE_PASSWORD=
# REQUIRED, and deliberately has no default because the supplier has not confirmed it (spec question 6):
#   basic_plain   HTTP Basic with the plain password
#   basic_sha256  HTTP Basic with the SHA-256 hex digest of the password
#   token         POST /oauth2/login, then send the returned token (see BAJIE_TOKEN_HEADER and BAJIE_TOKEN_PREFIX)
BAJIE_AUTH_MODE=
BAJIE_TOKEN_HEADER=Authorization
BAJIE_TOKEN_PREFIX=Bearer
# How the supplier writes borrowTime and returnTime when they carry no offset (for example 2026-11-13 10:00:00).
BAJIE_TIME_ZONE=UTC
# A long random string (24 characters or more) that forms part of the callback address. Keep it secret.
BAJIE_CALLBACK_SECRET_PATH=
# What the callback address answers with. The supplier has not said what it expects (spec question 2).
BAJIE_CALLBACK_ACK=success

# Which value the supplier wants as deviceId for each QR code (spec question 4). Station code = deviceId.
# Either a list, or JSON such as {"AJ1":{"deviceId":"DTA59552","name":"Al Jawhara"}}.
STATIONS=AJ1=DTA59552

# Where rentals are kept: a Supabase project (Project settings > API: the project URL and the service_role key).
# The service_role key can read and write everything. It lives only here, never in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The password-protected rentals list at /admin. 12 characters or more, otherwise the page stays switched off.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Pricing and limits (spec section 3). All money in pence. These are the defaults.
RENTAL_PRICE_PER_HOUR_PENCE=300
RENTAL_FIRST_CHARGE_PENCE=300
RENTAL_MAX_RENT_PENCE=2000
RENTAL_NON_RETURN_FEE_PENCE=2000
RENTAL_CUTOFF_HOURS=12
# For the real-machine cut-off test only (spec section 11, test 5): a cut-off in minutes that replaces the hours.
RENTAL_CUTOFF_MINUTES_OVERRIDE=
# Other settings (defaults shown).
RENTAL_RELEASE_TIMEOUT_SECONDS=60
RENTAL_POLL_INTERVAL_SECONDS=60
RENTAL_SETTLE_MAX_ATTEMPTS=3
RENTAL_SETTLE_RETRY_MINUTES=60
RENTAL_STALE_UNPAID_MINUTES=30
# A power bank counts as charged enough to rent at or above this level. Confirm the unit on the real machine.
RENTAL_MIN_BATTERY_VOL=30
# Set to "no" to pause rentals: the page says unavailable and nothing can start.
RENTALS_ENABLED=yes
# Free power banks for the venue's staff. Name:code pairs, commas between people. Empty means off (link hidden).
# Codes: at least 8 letters and digits, with both. Never put real codes in this file or the repo.
STAFF_CODES=
# At most this many staff power banks out of one machine at once, so guests can always rent.
STAFF_MAX_OUT=2

# ---- Local testing only. All of these are refused on Netlify. -------------------------------------------------
# With all three set, the whole flow runs with no Stripe, supplier or database account, and /__dev/* has controls.
# SUPPLIER_MODE=fake
# RENTAL_STORE=memory
# STRIPE_FAKE=yes
