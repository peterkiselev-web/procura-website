# Copy to .env and fill in. Never commit .env.
PORT=3000
HOST=127.0.0.1

# Optional: email each enquiry (requires `npm install nodemailer`)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ENQUIRY_TO=
ENQUIRY_FROM=

# Venue waitlist (also set these under Netlify > Site configuration > Environment variables).
# The token lets the site write into ClickUp. Never commit it.
CLICKUP_TOKEN=
CLICKUP_LIST_ID=
# Optional. Comma separated ClickUp user ids to assign each waitlisted venue to.
CLICKUP_ASSIGNEE_IDS=
# Optional. Days until the first update reminder. Default 14.
UPDATE_CADENCE_DAYS=14
# Optional. Name of the status a venue moves to once it submits. Default Waitlisted.
WAITLIST_STATUS=Waitlisted
